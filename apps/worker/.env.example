# Copy to .env to override defaults. Picked up automatically by `npm run start`/`serve`
# (via Node's --env-file-if-exists); for `npm run dev`/`dev:serve` (tsx), export these manually first.

# Where the SQLite database lives. Defaults to <repo-root>/data/monitor.sqlite if unset.
MONITOR_DB_PATH=../../data/monitor.sqlite

# HTTP port for the worker's HTTP trigger (serve/dev:serve only; unused by the CLI run).
PORT=3002
